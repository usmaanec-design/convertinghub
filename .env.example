LOCIZE_API_KEY=

# Adobe PDF Services credentials - server-side only, never exposed to frontend/browser
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_TIMEOUT_MS=60000
ADOBE_RETRY_AFTER_MS=300000

# Backend LibreOffice Bridge Server URL (for live online deployment)
# Example: VITE_BRIDGE_URL=https://convertinghub-backend.onrender.com/api/libreoffice
VITE_BRIDGE_URL=

# Firebase Config (Optional overrides)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
